region      = "eu-west-1"
name_prefix = "aws-oidc-warden"

tags = {
  environment = "prod"
  owner       = "platform-team"
}

# STS role session name, visible in CloudTrail on every AssumeRole.
# role_session_name = "aws-oidc-warden"

# --- Token validation (rendered as a single GitHub Actions issuers[] entry) ---
issuer    = "https://token.actions.githubusercontent.com"
audiences = ["sts.amazonaws.com"]

# --- Multi-issuer (alternative to the singular issuer/audiences above) ---
# Mutually exclusive with `issuer`/`audiences`. In apigw mode each entry gets
# its own JWT Authorizer on its own route, so one API can serve several
# issuers. `provider` and `session_tags` are required per entry; `route_key` is
# required in apigw mode and must be omitted in self mode.
# issuers = {
#   github = {
#     issuer       = "https://token.actions.githubusercontent.com"
#     audiences    = ["sts.amazonaws.com"]
#     provider     = "github"
#     route_key    = "POST /github"
#     session_tags = { repo = "repository", repo-owner = "repository_owner", ref = "ref", actor = "actor" }
#   }
#   gitlab = {
#     issuer          = "https://gitlab.com"
#     audiences       = ["aws-oidc-warden"]
#     provider        = "generic"
#     route_key       = "POST /gitlab"
#     claim_mappings  = { subject = "project_path" }
#     required_claims = ["project_path"]
#     session_tags    = { project = "project_path" }
#   }
# }

# --- Cache: choose at most one backend (memory if both false) ---
enable_dynamodb_cache = true
enable_s3_cache       = false
cache_ttl             = "1h"

# --- Optional features ---
# audit_required (default true) implies enable_s3_logs: each allow decision's
# audit record is written to S3 before credentials are returned (fail-closed).
# audit_required               = true
# log_claim_values (default true) puts the requesting identity in each record
# (claims.repository/ref/event_name/actor + canonical subject).
# log_claim_values             = true
enable_s3_logs               = false
enable_session_policy_bucket = false

# --- Lambda sizing ---
lambda_memory_size = 256
lambda_timeout     = 15
log_level          = "info"

# --- Roles the warden may assume on behalf of repos ---
assumable_role_arns = [
  "arn:aws:iam::111122223333:role/github-actions-example",
]

# --- Subject -> role mappings (v2 schema) ---
# `subject` is the canonical subject (GitHub: the `repository` claim,
# "owner/repo"); `conditions` are auto-anchored regexes on raw claims (AND-ed).
# `issuer` (the issuer URL, not a var.issuers map key) is required once more
# than one issuer is configured (see the multi-issuer block above), unless
# default_issuer is set — the service refuses to boot otherwise. With the
# single-issuer shorthand active (as below) it's optional.
#
# `role_groups` (expand one set of role/condition defaults across many
# subjects) is not exposed as a Terraform variable in this module — it is a
# config.yaml-only convenience. To grant the same roles/conditions to many
# repos through Terraform, repeat a role_mappings entry per subject (or per
# subject-set via a regex, as in the second entry below).
#
# The first entry below is a fully-populated single-repo mapping (every field
# this schema supports, including the regex-only `conditions` sub-fields); the
# second shows a regex `subject` matching many repositories. Most real
# mappings only need a few of these fields — trim what you don't use.
role_mappings = [
  {
    subject = "my-org/my-repo" # canonical subject; GitHub: "owner/repo"
    # issuer is redundant here: with the single-issuer shorthand active (as
    # above), that sole issuer applies regardless. Leaving a hardcoded issuer
    # live is a trap for a GHES/self-hosted operator who changes `issuer`
    # above without touching this value — clean plan, dead cold start on a
    # URL they never typed. Uncomment and set only once a second issuer
    # exists (see the multi-issuer block above).
    # issuer = "https://token.actions.githubusercontent.com"
    roles = ["arn:aws:iam::111122223333:role/github-actions-example"]
    # Inline session policy (JSON string) scoping the assumed role. Mutually
    # exclusive with session_policy_file (inline wins if both are set) —
    # shown here only for reference; leave one of the two, not both.
    # session_policy = "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Deny\",\"Action\":[\"iam:*\"],\"Resource\":\"*\"}]}"
    # S3 key (relative to session_policy_bucket) holding the session policy.
    # session_policy_file = "session-policies/my-org/my-repo/policy.json"
    conditions = {
      branch        = "refs/heads/main" # regex against the `ref` claim (alias of `ref` below)
      ref           = "refs/heads/main" # same underlying claim as `branch`; use whichever name reads better
      ref_type      = "branch"          # "branch" | "tag" | ...
      event_name    = "push"            # e.g. "push", "pull_request", "workflow_dispatch"
      workflow_ref  = "my-org/my-repo/.github/workflows/deploy.yml@refs/heads/main" # exact workflow that triggered the run
      environment   = "production"      # checked against the `runner_environment` claim
      actor_matches = ["^octocat$"]      # regexes against `actor`, OR'd within the list
    }
    # Overrides the global role_session_name (top of this file) for roles
    # granted by THIS mapping only, so CloudTrail names the requester instead
    # of the service. STS charset [\w+=,.@-], 2-64 chars — "/" is excluded, so
    # a repository name cannot be used verbatim. Invalid values fail the
    # service at boot rather than being silently reshaped.
    role_session_name = "my-org-my-repo-deploy"
  },
  {
    # Regex subject matching every "my-org/service-*" repository.
    # role_session_name below names the WHOLE matched set, not each
    # repository individually — it is a static string, not a template.
    # Per-repository names require one mapping per repository, as above.
    subject           = "my-org/service-.*"
    roles             = ["arn:aws:iam::111122223333:role/github-actions-readonly"]
    role_session_name = "my-org-services"
  },
]

# --- Optional tag-based authorization ---
# tag_auth = {
#   enabled     = true
#   default_org = "my-org"
# }

# RECOMMENDED. Marks every session tag transitive so the requester's identity
# survives role chaining and cannot be altered downstream. Without it, tags are
# dropped at the first role hop and ABAC policies past that hop can no longer
# tell who the caller was. Defaults to false only for upgrade safety: enabling
# it breaks a target role that re-tags with the same keys while chaining.
# session_tags_transitive = true

# --- Optional cross-account policy gate ---
# enabled=true lets the Lambda assume target roles in member accounts
# directly (one hop) — add those target role ARNs/patterns to
# assumable_role_arns above, preferring per-account patterns like
# "arn:aws:iam::111122223333:role/<prefix>*" over "arn:aws:iam::*:role/*".
# Only add the spoke pattern (e.g. "arn:aws:iam::*:role/aow-spoke") if using
# cross-account tag_auth, since the spoke is a tag-read broker, not an
# assume target. enabled=false hard-denies all cross-account operations.
# cross_account = {
#   enabled          = true
#   allowed_accounts = ["111122223333", "444455556666"]
# }

# --- Public endpoint hardening ---
# The endpoint is public; unknown-issuer tokens are denied in-app (401, before
# any JWKS fetch), but in self mode the Lambda is still INVOKED per request.
# To reject junk traffic before invocation:
#   jwt_validation_mode = "apigw" -> one JWT Authorizer per issuer rejects
#     invalid tokens at the gateway before Lambda is invoked (RECOMMENDED).
#     Works with a single issuer or several (see the issuers example above;
#     API Gateway allows at most 10 authorizers per HTTP API).
#   api_gateway_type = "rest" + enable_waf = true -> WAF rate limiting +
#     managed rules + POST-/verify-only filtering (self mode only — WAF
#     cannot attach to HTTP APIs). Use this when you want per-source-IP rate
#     limiting rather than per-route token validation.
# No IP allowlisting in either posture: GitHub-hosted runner IP ranges are vast
# and dynamic, and self-hosted runners can be anywhere.
# api_gateway_type = "rest"
# enable_waf       = true
# waf_rate_limit   = 300 # requests per source IP per 5 min
# Always-on knobs (both API types):
# throttling_burst_limit      = 50
# throttling_rate_limit       = 100
# lambda_reserved_concurrency = 50 # cap invocation blast radius; -1 = unreserved

# --- JWT Validation Mode ---
# "self"  (default) — Lambda validates JWT signature itself using JWKS.
#            Build with the default: ./deploy/opentofu/build.sh
# "apigw" — API Gateway JWT Authorizer validates; Lambda reads pre-validated claims
#            from event.requestContext.authorizer.jwt.claims. Build with:
#            ./deploy/opentofu/build.sh apigatewayv2
#            Requires api_gateway_type = "http" (JWT Authorizers are HTTP API-only).
#            SECURITY: Lambda resource policy restricts invocations to the API GW
#            (source_arn = execution_arn/*/*) — direct invocations are blocked.
# "alb" mode is NOT supported by this stack — it needs the `alb` Lambda binary
# behind an Application Load Balancer, which this module does not provision.
jwt_validation_mode = "self"
# The JWT Authorizer follows `issuer`/`audiences` above by default; override
# only if the authorizer must validate against a different issuer/audiences.
# Only valid with the singular issuer/audiences shorthand — rejected at plan
# time if var.issuers is set, since each entry there drives its own authorizer.
# jwt_authorizer_issuer    = "https://token.actions.githubusercontent.com"
# jwt_authorizer_audiences = ["sts.amazonaws.com"]
