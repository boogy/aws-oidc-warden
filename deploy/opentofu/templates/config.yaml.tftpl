# Managed by OpenTofu — do not edit by hand.
role_session_name: ${jsonencode(cfg.role_session_name)}
default_issuer: ${cfg.default_issuer == null ? "null" : jsonencode(cfg.default_issuer)}

issuers:${length(cfg.issuers) == 0 ? " []" : ""}
%{ for iss in cfg.issuers ~}
  - issuer: ${jsonencode(iss.issuer)}
    provider: ${jsonencode(iss.provider)}
    audiences:${iss.audiences == null ? " null" : (length(iss.audiences) == 0 ? " []" : "")}
%{ if iss.audiences != null ~}
%{ for a in iss.audiences ~}
      - ${jsonencode(a)}
%{ endfor ~}
%{ endif ~}
    required_claims:${iss.required_claims == null ? " null" : (length(iss.required_claims) == 0 ? " []" : "")}
%{ if iss.required_claims != null ~}
%{ for c in iss.required_claims ~}
      - ${jsonencode(c)}
%{ endfor ~}
%{ endif ~}
    claim_mappings:${iss.claim_mappings == null ? " null" : (length(iss.claim_mappings) == 0 ? " {}" : "")}
%{ if iss.claim_mappings != null ~}
%{ for k in sort(keys(iss.claim_mappings)) ~}
      ${jsonencode(k)}: ${jsonencode(iss.claim_mappings[k])}
%{ endfor ~}
%{ endif ~}
    jwks_uri: ${iss.jwks_uri == null ? "null" : jsonencode(iss.jwks_uri)}
    session_tags:${iss.session_tags == null ? " null" : (length(iss.session_tags) == 0 ? " {}" : "")}
%{ if iss.session_tags != null ~}
%{ for k in sort(keys(iss.session_tags)) ~}
      ${jsonencode(k)}: ${jsonencode(iss.session_tags[k])}
%{ endfor ~}
%{ endif ~}
%{ endfor ~}

cache:
  type: ${jsonencode(cfg.cache.type)}
  ttl: ${jsonencode(cfg.cache.ttl)}
  dynamodb_table: ${cfg.cache.dynamodb_table == null ? "null" : jsonencode(cfg.cache.dynamodb_table)}
  s3_bucket: ${cfg.cache.s3_bucket == null ? "null" : jsonencode(cfg.cache.s3_bucket)}
  s3_prefix: ${cfg.cache.s3_prefix == null ? "null" : jsonencode(cfg.cache.s3_prefix)}

jwt_validation:
  mode: ${jsonencode(cfg.jwt_validation.mode)}

audit_required: ${cfg.audit_required}
log_claim_values: ${cfg.log_claim_values}
session_tags_transitive: ${cfg.session_tags_transitive}
log_to_s3: ${cfg.log_to_s3}
log_bucket: ${cfg.log_bucket == null ? "null" : jsonencode(cfg.log_bucket)}
log_prefix: ${cfg.log_prefix == null ? "null" : jsonencode(cfg.log_prefix)}
session_policy_bucket: ${cfg.session_policy_bucket == null ? "null" : jsonencode(cfg.session_policy_bucket)}

tag_auth:
  enabled: ${cfg.tag_auth.enabled}
  tag_prefix: ${jsonencode(cfg.tag_auth.tag_prefix)}
  default_org: ${cfg.tag_auth.default_org == null ? "null" : jsonencode(cfg.tag_auth.default_org)}
  transitive_session_tags: ${cfg.tag_auth.transitive_session_tags}

cross_account:
  enabled: ${cfg.cross_account.enabled}
  spoke_role_name: ${jsonencode(cfg.cross_account.spoke_role_name)}
  external_id: ${cfg.cross_account.external_id == null ? "null" : jsonencode(cfg.cross_account.external_id)}
  spoke_session_duration: ${jsonencode(cfg.cross_account.spoke_session_duration)}
  allowed_accounts:${length(cfg.cross_account.allowed_accounts) == 0 ? " []" : ""}
%{ for acct in cfg.cross_account.allowed_accounts ~}
    - ${jsonencode(acct)}
%{ endfor ~}

role_mappings:${length(cfg.role_mappings) == 0 ? " []" : ""}
%{ for m in cfg.role_mappings ~}
  - subject: ${jsonencode(m.subject)}
%{ if m.issuer != null ~}
    issuer: ${jsonencode(m.issuer)}
%{ endif ~}
%{ if m.roles != null ~}
    roles:${length(m.roles) == 0 ? " []" : ""}
%{ for r in m.roles ~}
      - ${jsonencode(r)}
%{ endfor ~}
%{ endif ~}
%{ if m.session_policy != null ~}
    session_policy: |-
      ${indent(6, m.session_policy)}
%{ endif ~}
%{ if m.session_policy_file != null ~}
    session_policy_file: ${jsonencode(m.session_policy_file)}
%{ endif ~}
%{ if m.role_session_name != null ~}
    role_session_name: ${jsonencode(m.role_session_name)}
%{ endif ~}
%{ if m.conditions != null ~}
    conditions:
%{ if m.conditions.branch != null ~}
      branch: ${jsonencode(m.conditions.branch)}
%{ endif ~}
%{ if m.conditions.ref != null ~}
      ref: ${jsonencode(m.conditions.ref)}
%{ endif ~}
%{ if m.conditions.ref_type != null ~}
      ref_type: ${jsonencode(m.conditions.ref_type)}
%{ endif ~}
%{ if m.conditions.event_name != null ~}
      event_name: ${jsonencode(m.conditions.event_name)}
%{ endif ~}
%{ if m.conditions.workflow_ref != null ~}
      workflow_ref: ${jsonencode(m.conditions.workflow_ref)}
%{ endif ~}
%{ if m.conditions.environment != null ~}
      environment: ${jsonencode(m.conditions.environment)}
%{ endif ~}
%{ if m.conditions.actor_matches != null ~}
      actor_matches:${length(m.conditions.actor_matches) == 0 ? " []" : ""}
%{ for a in m.conditions.actor_matches ~}
        - ${jsonencode(a)}
%{ endfor ~}
%{ endif ~}
%{ endif ~}
%{ endfor ~}
