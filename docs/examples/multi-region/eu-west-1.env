# Lambda environment variables for the eu-west-1 (primary) deployment.
# Every resource named here lives in eu-west-1.
# Directory holding config.yaml; /var/task is the root of a zip package.
CONFIG_PATH=/var/task
CONFIG_NAME=config
LOG_LEVEL=info
AOW_MAPPINGS_FILE=s3://octo-aow-config-111122223333-eu-west-1/mappings.yaml
AOW_CACHE_DYNAMODB_TABLE=aow-jwks-cache
AOW_LOG_BUCKET=octo-aow-audit-111122223333-eu-west-1
AOW_SESSION_POLICY_BUCKET=octo-aow-session-policies-111122223333-eu-west-1
